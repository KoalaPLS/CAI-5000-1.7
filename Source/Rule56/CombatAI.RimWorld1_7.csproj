<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>CombatAI</RootNamespace>
    <AssemblyName>CombatAI</AssemblyName>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <OutputPath>..\..\1.7\Assemblies\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <Optimize>true</Optimize>
    <DebugType>pdbonly</DebugType>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>

    <RimWorldDir Condition="'$(RimWorldDir)' == ''">C:\Steam\steamapps\common\RimWorld</RimWorldDir>
    <RimWorldAssemblyDir Condition="Exists('$(RimWorldDir)\Assembly-CSharp.dll')">$(RimWorldDir)</RimWorldAssemblyDir>
    <RimWorldAssemblyDir Condition="'$(RimWorldAssemblyDir)' == '' and Exists('$(RimWorldDir)\RimWorldWin64_Data\Managed\Assembly-CSharp.dll')">$(RimWorldDir)\RimWorldWin64_Data\Managed</RimWorldAssemblyDir>

    <HarmonyWorkshopDir Condition="'$(HarmonyWorkshopDir)' == ''">$(RimWorldDir)\..\..\workshop\content\294100\2009463077</HarmonyWorkshopDir>
    <HarmonyAssembly Condition="'$(HarmonyAssembly)' == '' and Exists('$(HarmonyWorkshopDir)\Current\Assemblies\0Harmony.dll')">$(HarmonyWorkshopDir)\Current\Assemblies\0Harmony.dll</HarmonyAssembly>
    <HarmonyAssembly Condition="'$(HarmonyAssembly)' == '' and Exists('$(HarmonyWorkshopDir)\1.7\Assemblies\0Harmony.dll')">$(HarmonyWorkshopDir)\1.7\Assemblies\0Harmony.dll</HarmonyAssembly>
    <HarmonyAssembly Condition="'$(HarmonyAssembly)' == '' and Exists('$(HarmonyWorkshopDir)\Assemblies\0Harmony.dll')">$(HarmonyWorkshopDir)\Assemblies\0Harmony.dll</HarmonyAssembly>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="**\*.cs"
             Exclude="ITRegionGridPrepatched.cs;bin\**\*;obj\**\*" />

    <Reference Include="Assembly-CSharp">
      <HintPath>$(RimWorldAssemblyDir)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityStubs">
      <HintPath>$(RimWorldAssemblyDir)\UnityStubs.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Waylith">
      <HintPath>$(RimWorldAssemblyDir)\Waylith.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <!-- RimWorld 1.7/Waylith still exposes Unity API type identities through the
         compatibility module assemblies. CAI directly consumes these types in its
         GUI, placement workers, asset-bundle loader, input helpers, and UI code, so
         they must be explicit compile references rather than relying on transitive
         Assembly-CSharp metadata. -->
    <Reference Include="UnityEngine" Condition="Exists('$(RimWorldAssemblyDir)\UnityEngine.dll')">
      <HintPath>$(RimWorldAssemblyDir)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(RimWorldAssemblyDir)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(RimWorldAssemblyDir)\UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(RimWorldAssemblyDir)\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.AssetBundleModule" Condition="Exists('$(RimWorldAssemblyDir)\UnityEngine.AssetBundleModule.dll')">
      <HintPath>$(RimWorldAssemblyDir)\UnityEngine.AssetBundleModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule" Condition="Exists('$(RimWorldAssemblyDir)\UnityEngine.InputLegacyModule.dll')">
      <HintPath>$(RimWorldAssemblyDir)\UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.InputModule" Condition="Exists('$(RimWorldAssemblyDir)\UnityEngine.InputModule.dll')">
      <HintPath>$(RimWorldAssemblyDir)\UnityEngine.InputModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UI" Condition="Exists('$(RimWorldAssemblyDir)\UnityEngine.UI.dll')">
      <HintPath>$(RimWorldAssemblyDir)\UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UIModule" Condition="Exists('$(RimWorldAssemblyDir)\UnityEngine.UIModule.dll')">
      <HintPath>$(RimWorldAssemblyDir)\UnityEngine.UIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <Reference Include="0Harmony" Condition="'$(HarmonyAssembly)' != ''">
      <HintPath>$(HarmonyAssembly)</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="ValidateRimWorld17References" BeforeTargets="ResolveReferences">
    <Error Condition="'$(RimWorldAssemblyDir)' == '' or !Exists('$(RimWorldAssemblyDir)\Assembly-CSharp.dll')"
           Text="RimWorld 1.7 Assembly-CSharp.dll was not found. Pass -p:RimWorldDir=C:\path\to\RimWorld if your install is elsewhere." />
    <Error Condition="!Exists('$(RimWorldAssemblyDir)\UnityStubs.dll')"
           Text="UnityStubs.dll was not found in $(RimWorldAssemblyDir). This project requires the RimWorld 1.7 / Waylith assembly set." />
    <Error Condition="!Exists('$(RimWorldAssemblyDir)\Waylith.dll')"
           Text="Waylith.dll was not found in $(RimWorldAssemblyDir). This project requires the RimWorld 1.7 / Waylith assembly set." />
    <Error Condition="!Exists('$(RimWorldAssemblyDir)\UnityEngine.CoreModule.dll')"
           Text="UnityEngine.CoreModule.dll was not found in $(RimWorldAssemblyDir). CAI directly consumes RimWorld 1.7 Unity compatibility types such as Vector2, Rect, and Color." />
    <Error Condition="!Exists('$(RimWorldAssemblyDir)\UnityEngine.TextRenderingModule.dll')"
           Text="UnityEngine.TextRenderingModule.dll was not found in $(RimWorldAssemblyDir). CAI directly consumes TextAnchor and text rendering compatibility types." />
    <Error Condition="!Exists('$(RimWorldAssemblyDir)\UnityEngine.IMGUIModule.dll')"
           Text="UnityEngine.IMGUIModule.dll was not found in $(RimWorldAssemblyDir). CAI directly consumes IMGUI types such as GUIStyle." />
    <Error Condition="'$(HarmonyAssembly)' == '' or !Exists('$(HarmonyAssembly)')"
           Text="Harmony 0Harmony.dll was not found. Pass -p:HarmonyAssembly=C:\path\to\0Harmony.dll." />
  </Target>
</Project>