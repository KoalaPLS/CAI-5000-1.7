<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <GenerateDependencyFile>true</GenerateDependencyFile>
    <RimWorldDir Condition="'$(RimWorldDir)' == ''">C:\Steam\steamapps\common\RimWorld</RimWorldDir>
    <HarmonyWorkshopDir Condition="'$(HarmonyWorkshopDir)' == ''">$(RimWorldDir)\..\..\workshop\content\294100\2009463077</HarmonyWorkshopDir>
    <HarmonyAssembly Condition="'$(HarmonyAssembly)' == '' and Exists('$(HarmonyWorkshopDir)\Current\Assemblies\0Harmony.dll')">$(HarmonyWorkshopDir)\Current\Assemblies\0Harmony.dll</HarmonyAssembly>
    <HarmonyAssembly Condition="'$(HarmonyAssembly)' == '' and Exists('$(HarmonyWorkshopDir)\1.7\Assemblies\0Harmony.dll')">$(HarmonyWorkshopDir)\1.7\Assemblies\0Harmony.dll</HarmonyAssembly>
    <HarmonyAssembly Condition="'$(HarmonyAssembly)' == '' and Exists('$(HarmonyWorkshopDir)\Assemblies\0Harmony.dll')">$(HarmonyWorkshopDir)\Assemblies\0Harmony.dll</HarmonyAssembly>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Rule56\CombatAI.RimWorld1_7.csproj" />
    <Reference Include="Assembly-CSharp">
      <HintPath>$(RimWorldDir)\Assembly-CSharp.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="UnityStubs">
      <HintPath>$(RimWorldDir)\UnityStubs.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Waylith">
      <HintPath>$(RimWorldDir)\Waylith.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(HarmonyAssembly)</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <Target Name="ValidateAuditReferences" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(RimWorldDir)\Assembly-CSharp.dll')" Text="RimWorld 1.7 Assembly-CSharp.dll not found in $(RimWorldDir)." />
    <Error Condition="!Exists('$(RimWorldDir)\UnityStubs.dll')" Text="RimWorld 1.7 UnityStubs.dll not found in $(RimWorldDir)." />
    <Error Condition="'$(HarmonyAssembly)' == '' or !Exists('$(HarmonyAssembly)')" Text="Harmony 0Harmony.dll not found." />
  </Target>
</Project>
